def main() {
    xs = List[int]()
    xs.push(3)
    xs.push(1)
    xs.push(2)
    print(xs.index_of(1), xs.index_of(9))
    xs.insert(1, 9)
    print(xs.get(0), xs.get(1), xs.get(2), xs.get(3))
    print(xs.remove(9), xs.remove(9), xs.len())
    print(xs.remove_at(0), xs.len())
    xs.reverse()
    print(xs.get(0), xs.get(1))
    ys = List[str]()
    ys.push("b")
    ys.push("a")
    ys.reverse()
    print(ys.get(0), ys.get(1))
    fs = List[float]()
    fs.push(1)
    fs.insert(0, 2)
    fs.set(1, 3)
    print(fs.get(0), fs.get(1))
}
