# gzip: gzip/zlib/raw deflate decompression, format detection, corrupted input, output limits

import bytes
import gzip

def from_ints(vals: List[int]) -> Bytes {
    b = bytes.bytes_new(vals.len())
    for v in vals {
        b.push(v)
    }
    return b
}

# gzip("compressed payload")
def gzip_payload() -> Bytes {
    vals = List[int]()
    vals.push(31)
    vals.push(139)
    vals.push(8)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(2)
    vals.push(255)
    vals.push(75)
    vals.push(206)
    vals.push(207)
    vals.push(45)
    vals.push(40)
    vals.push(74)
    vals.push(45)
    vals.push(46)
    vals.push(78)
    vals.push(77)
    vals.push(81)
    vals.push(40)
    vals.push(72)
    vals.push(172)
    vals.push(204)
    vals.push(201)
    vals.push(79)
    vals.push(76)
    vals.push(1)
    vals.push(0)
    vals.push(36)
    vals.push(26)
    vals.push(216)
    vals.push(213)
    vals.push(18)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    return from_ints(vals)
}

# zlib.compress("compressed payload")
def zlib_payload() -> Bytes {
    vals = List[int]()
    vals.push(120)
    vals.push(156)
    vals.push(75)
    vals.push(206)
    vals.push(207)
    vals.push(45)
    vals.push(40)
    vals.push(74)
    vals.push(45)
    vals.push(46)
    vals.push(78)
    vals.push(77)
    vals.push(81)
    vals.push(40)
    vals.push(72)
    vals.push(172)
    vals.push(204)
    vals.push(201)
    vals.push(79)
    vals.push(76)
    vals.push(1)
    vals.push(0)
    vals.push(69)
    vals.push(197)
    vals.push(7)
    vals.push(64)
    return from_ints(vals)
}

# raw deflate("compressed payload"), no gzip/zlib container header
def raw_payload() -> Bytes {
    vals = List[int]()
    vals.push(75)
    vals.push(206)
    vals.push(207)
    vals.push(45)
    vals.push(40)
    vals.push(74)
    vals.push(45)
    vals.push(46)
    vals.push(78)
    vals.push(77)
    vals.push(81)
    vals.push(40)
    vals.push(72)
    vals.push(172)
    vals.push(204)
    vals.push(201)
    vals.push(79)
    vals.push(76)
    vals.push(1)
    vals.push(0)
    return from_ints(vals)
}

# gzip("A" * 10000), for the output limit
def big_payload() -> Bytes {
    vals = List[int]()
    vals.push(31)
    vals.push(139)
    vals.push(8)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(2)
    vals.push(255)
    vals.push(237)
    vals.push(193)
    vals.push(1)
    vals.push(13)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(194)
    vals.push(160)
    vals.push(108)
    vals.push(239)
    vals.push(95)
    vals.push(202)
    vals.push(28)
    vals.push(110)
    vals.push(64)
    vals.push(1)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(192)
    vals.push(191)
    vals.push(1)
    vals.push(237)
    vals.push(200)
    vals.push(67)
    vals.push(60)
    vals.push(16)
    vals.push(39)
    vals.push(0)
    vals.push(0)
    return from_ints(vals)
}

# raw deflate("A" * 10000), no gzip/zlib container header
def raw_big_payload() -> Bytes {
    vals = List[int]()
    vals.push(237)
    vals.push(193)
    vals.push(1)
    vals.push(13)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(194)
    vals.push(160)
    vals.push(108)
    vals.push(239)
    vals.push(95)
    vals.push(202)
    vals.push(28)
    vals.push(110)
    vals.push(64)
    vals.push(1)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(0)
    vals.push(192)
    vals.push(191)
    vals.push(1)
    return from_ints(vals)
}

def main() {
    g = gzip_payload()
    z = zlib_payload()
    raw = raw_payload()

    print("is_gzip", gzip.is_gzip(@g), gzip.is_gzip(@z), gzip.is_gzip(@raw))
    print("is_zlib", gzip.is_zlib(@z), gzip.is_zlib(@g), gzip.is_zlib(@raw))

    rg = gzip.decompress(@g)
    print("gzip", rg.ok, rg.data.len, rg.data.to_str())

    rz = gzip.decompress(@z)
    print("zlib", rz.ok, rz.data.to_str())

    rr = gzip.decompress(@raw)
    print("raw", rr.ok, rr.data.to_str())

    rm = gzip.decompress_mem(g.data, g.len)
    print("mem", rm.ok, rm.data.to_str())

    empty = bytes.bytes_new(0)
    re = gzip.decompress(@empty)
    print("empty", re.ok, re.error)

    bad = bytes.bytes_new(4)
    bad.push(31)
    bad.push(139)
    bad.push(8)
    bad.push(0)
    rb = gzip.decompress(@bad)
    print("bad", rb.ok, rb.error.len() > 0)

    big = big_payload()
    rl = gzip.decompress_limit(@big, 100)
    print("limit", rl.ok, rl.error)
    ok = gzip.decompress_limit(@big, 20000)
    print("under_limit", ok.ok, ok.data.len)

    rawbig = raw_big_payload()
    rb2 = gzip.decompress(@rawbig)
    print("raw_big", rb2.ok, rb2.data.len)
    rrl = gzip.decompress_limit(@rawbig, 100)
    print("limit_raw", rrl.ok, rrl.error)

    print("members", rg.members, rz.members)
    multi = gzip_payload()
    second = gzip_payload()
    multi.append(@second)
    rm2 = gzip.decompress(@multi)
    print("multi", rm2.ok, rm2.data.len, rm2.members)

    text = bytes.bytes_from_str("hello hello hello")
    cz = gzip.compress(@text)
    print("compress", cz.ok, cz.members, cz.data.len > 0)
    cdata = cz.data
    back = gzip.decompress(@cdata)
    print("roundtrip", back.ok, back.data.to_str(), back.members)

    empty2 = bytes.bytes_new(0)
    ce = gzip.compress(@empty2)
    edata = ce.data
    eb = gzip.decompress(@edata)
    print("compress_empty", ce.ok, eb.ok, eb.data.len)

    # trailing garbage after a gzip member is ignored
    tg = gzip_payload()
    junk = bytes.bytes_from_str("junk")
    tg.append(@junk)
    rt = gzip.decompress(@tg)
    print("trailing", rt.ok, rt.data.to_str())

    # corrupted CRC trailer
    cg = gzip_payload()
    cg.set(cg.len - 8, cg.get(cg.len - 8) ^ 255)
    rc = gzip.decompress(@cg)
    print("crc", rc.ok, rc.error)

    # truncated deflate stream
    tr = g.slice(0, 20)
    rtr = gzip.decompress(@tr)
    print("truncated", rtr.ok, rtr.error)

    # level 0 = stored blocks, level 9 = fixed-Huffman LZ77
    z0 = gzip.compress_level(@text, 0)
    d0 = z0.data
    b0 = gzip.decompress(@d0)
    print("level0", z0.ok, b0.ok, b0.data.to_str())
    z9 = gzip.compress_level(@text, 9)
    d9 = z9.data
    b9 = gzip.decompress(@d9)
    print("level9", z9.ok, b9.ok, b9.data.to_str(), b9.members)

    # limit <= 0 means unlimited; zlib containers honour the limit too
    rz0 = gzip.decompress_limit(@g, 0)
    print("limit_zero", rz0.ok, rz0.data.len)
    zl = gzip.decompress_limit(@z, 5)
    print("zlib_limit", zl.ok, zl.error)
}
