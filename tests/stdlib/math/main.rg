import math

def main() {
    print(abs(-5), abs(2.5), abs(3))
    print(min(3, 7), max(3, 7), min(2.5, 1), max(2, 9.5))
    print(sqrt(9), sqrt(2))
    print(pow(2, 10), pow(2.5, 2))
    print(floor(3.7), ceil(3.2), floor(-1.2), ceil(-1.8))
    print(math.sqrt(16), math.abs(-9), math.min(4, 2), math.max(1.5, 0))
}
